#!/bin/bash

# Point lazygit at the current Omarchy theme.
#
# Omarchy themes every terminal app it ships a template for, but not lazygit,
# which falls back to its own green borders and a blue selection bar — a
# palette that belongs to no Omarchy theme. This regenerates lazygit's config
# from whichever theme is current, so it follows a theme switch.
#
# Row backgrounds have to be hex: lazygit's named colors are the 16 ANSI slots,
# and none of them is a surface tint. Everything else is read from colors.toml
# too, so nothing here is pinned to one theme.
#
# lazygit reads its config at start; relaunch it after a theme change.

set -euo pipefail

THEME_PATH="$HOME/.local/state/omarchy/current/theme"
COLORS="$THEME_PATH/colors.toml"
CONFIG="$HOME/.config/lazygit/config.yml"

[[ -f $COLORS ]] || exit 0

c() { omarchy-theme-color --file "$COLORS" "$1" 2>/dev/null; }

accent=$(c accent)
selection=$(c selection)
lighter_bg=$(c lighter_background)
muted=$(c muted)
cyan=$(c cyan)
red=$(c red)
dim_fg=$(c dark_foreground)

[[ $accent =~ ^#[0-9a-fA-F]{6}$ && $selection =~ ^#[0-9a-fA-F]{6}$ ]] || exit 0

mkdir -p "$(dirname "$CONFIG")"
cat >"$CONFIG" <<YAML
# Generated by omarchy hook theme-set.d/lazygit-colors.hook — do not edit.
# Regenerated on every \`omarchy theme set\`.
gui:
  theme:
    activeBorderColor:
      - "$accent"
      - bold
    inactiveBorderColor:
      - "$muted"
    searchingActiveBorderColor:
      - "$cyan"
      - bold
    optionsTextColor:
      - "$dim_fg"
    selectedLineBgColor:
      - "$selection"
    inactiveViewSelectedLineBgColor:
      - "$lighter_bg"
    cherryPickedCommitBgColor:
      - "$selection"
    cherryPickedCommitFgColor:
      - "$cyan"
    markedBaseCommitBgColor:
      - "$selection"
    markedBaseCommitFgColor:
      - "$accent"
    unstagedChangesColor:
      - "$red"
    defaultFgColor:
      - default
  nerdFontsVersion: "3"
YAML

exit 0
