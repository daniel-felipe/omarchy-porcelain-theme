#!/bin/bash

# Point GTK/libadwaita at the current Omarchy theme.
#
# Omarchy already flips GTK between Adwaita and Adwaita-dark and sets a Yaru
# icon theme, but stock Adwaita keeps its own grey surfaces and blue accent, so
# Nautilus and every GTK dialog sit visibly outside the palette. This writes the
# named colors Adwaita and libadwaita actually read, from whichever theme is
# current — so it stays correct after a theme switch, not just for one theme.
#
# Surfaces follow Omarchy's own stacking order rather than Adwaita's:
#
#   dark_background   window chrome, headerbars, sidebars   (the plate)
#   background        views, lists, text areas              (the content)
#   lifted            cards, dialogs, popovers              (one step above)
#
# `lifted` is the only value that cannot be a single token: on a dark theme the
# surface above `background` is `lighter_background`, but on a light theme
# `lighter_background` is the cursorline band and sits *below* it, so a light
# theme lifts toward white instead.
#
# GTK reads gtk.css at application start: already-running GTK apps keep their
# old colors until relaunched.

set -euo pipefail

THEME_PATH="$HOME/.local/state/omarchy/current/theme"
COLORS="$THEME_PATH/colors.toml"

[[ -f $COLORS ]] || exit 0

c() { omarchy-theme-color --file "$COLORS" "$1" 2>/dev/null; }

# Blend two hex colors. `amount` is how much of $2 ends up in the result.
mix() {
  awk -v a="${1#\#}" -v b="${2#\#}" -v amount="$3" '
    function hx(s, i) { return strtonum("0x" substr(s, i, 2)) }
    BEGIN {
      printf "#%02x%02x%02x\n",
        int(hx(a,1) * (1-amount) + hx(b,1) * amount + 0.5),
        int(hx(a,3) * (1-amount) + hx(b,3) * amount + 0.5),
        int(hx(a,5) * (1-amount) + hx(b,5) * amount + 0.5)
    }'
}

# WCAG relative luminance, scaled to an integer so bash can compare it.
luminance() {
  awk -v h="${1#\#}" '
    function hx(s, i) { return strtonum("0x" substr(s, i, 2)) / 255 }
    function lin(v) { return (v <= 0.04045) ? v / 12.92 : ((v + 0.055) / 1.055) ^ 2.4 }
    BEGIN { printf "%d\n", 100000 * (0.2126*lin(hx(h,1)) + 0.7152*lin(hx(h,3)) + 0.0722*lin(hx(h,5))) }'
}

contrast() {
  local l1 l2
  l1=$(luminance "$1")
  l2=$(luminance "$2")
  (( l1 < l2 )) && { local t=$l1; l1=$l2; l2=$t; }
  echo $(( (l1 + 5000) * 1000 / (l2 + 5000) ))
}

accent=$(c accent)
bg=$(c background)
dark_bg=$(c dark_background)
darker_bg=$(c darker_background)
lighter_bg=$(c lighter_background)
fg=$(c foreground)
bright_fg=$(c bright_foreground)
dim_fg=$(c dark_foreground)
muted=$(c muted)
red=$(c red)
orange=$(c orange)
yellow=$(c yellow)
green=$(c green)
mode=$(c mode)

[[ $accent =~ ^#[0-9a-fA-F]{6}$ && $bg =~ ^#[0-9a-fA-F]{6}$ ]] || exit 0

if [[ $mode == "light" ]]; then
  lifted=$(mix "$bg" "#ffffff" 0.6)
  shade=$(mix "$bg" "$bright_fg" 0.14)
else
  lifted=$lighter_bg
  shade=$darker_bg
fi

# `muted` is a theme's divider token, but it also has to serve as readable
# comment text, so it is tuned darker than a widget hairline wants to be.
# Pull it most of the way back toward the chrome it sits on.
#
# The ratio is set so this lands on the same hairline the terminal and the
# shell use. Three components were deriving a border independently and landing
# on three values within 6% of each other, which is a visible step when a GTK
# dialog sits next to a terminal. One value now, arrived at three ways.
border=$(mix "$dark_bg" "$muted" 0.42)

# Text that sits on top of a solid accent fill. Picking by the accent's own
# luminance only works on dark themes, where the lightest surface is also the
# text color; on a light theme `bright_foreground` is the darkest ink and
# `background` is the lightest surface. Test both and keep the readable one.
accent_fg=$bright_fg
(( $(contrast "$bg" "$accent") > $(contrast "$bright_fg" "$accent") )) && accent_fg=$bg

write_css() {
  local path="$1"
  mkdir -p "$(dirname "$path")"
  cat >"$path" <<CSS
/* Generated by omarchy hook theme-set.d/gtk-colors.hook — do not edit.
   Regenerated on every \`omarchy theme set\`. */

@define-color accent_color $accent;
@define-color accent_bg_color $accent;
@define-color accent_fg_color $accent_fg;

@define-color window_bg_color $dark_bg;
@define-color window_fg_color $fg;
@define-color view_bg_color $bg;
@define-color view_fg_color $fg;
@define-color headerbar_bg_color $dark_bg;
@define-color headerbar_fg_color $fg;
@define-color headerbar_border_color $border;
@define-color headerbar_backdrop_color $darker_bg;
@define-color sidebar_bg_color $dark_bg;
@define-color sidebar_fg_color $fg;
@define-color sidebar_backdrop_color $darker_bg;
@define-color secondary_sidebar_bg_color $darker_bg;
@define-color secondary_sidebar_fg_color $fg;
@define-color card_bg_color $lifted;
@define-color card_fg_color $fg;
@define-color dialog_bg_color $lifted;
@define-color dialog_fg_color $fg;
@define-color popover_bg_color $lifted;
@define-color popover_fg_color $fg;
@define-color thumbnail_bg_color $lifted;
@define-color thumbnail_fg_color $fg;
@define-color shade_color $shade;
@define-color scrollbar_outline_color $shade;

@define-color destructive_bg_color $red;
@define-color destructive_color $red;
@define-color destructive_fg_color $accent_fg;
@define-color error_bg_color $red;
@define-color error_color $red;
@define-color warning_bg_color $yellow;
@define-color warning_color $orange;
@define-color success_bg_color $green;
@define-color success_color $green;

/* GTK3 / Adwaita legacy names. */
@define-color theme_bg_color $dark_bg;
@define-color theme_fg_color $fg;
@define-color theme_base_color $bg;
@define-color theme_text_color $fg;
@define-color theme_selected_bg_color $accent;
@define-color theme_selected_fg_color $accent_fg;
@define-color insensitive_fg_color $dim_fg;
@define-color insensitive_base_color $dark_bg;
@define-color borders $border;
@define-color unfocused_borders $darker_bg;
CSS

  # libadwaita draws selected rows as alpha(currentColor, .1) — a grey wash
  # that never consults accent_bg_color. So a selected folder in Nautilus was
  # the one selected thing on the desktop that was not the accent. These
  # selectors are GTK4 node names; GTK3 does not know them and would only warn,
  # so they go in the GTK4 file alone.
  [[ $path == *gtk-4.0* ]] || return 0

  cat >>"$path" <<'CSS'

/* Selection is the accent everywhere else in the system; make it the accent
   here too. Kept as a wash rather than a solid fill so the row still reads as
   a list row and the label keeps its normal ink. */
.navigation-sidebar > row:selected,
.navigation-sidebar > row.activatable:selected,
listview > row:selected,
gridview > child:selected,
flowbox > flowboxchild:selected {
  background-color: alpha(@accent_bg_color, 0.14);
  color: @window_fg_color;
}

.navigation-sidebar > row:selected:hover,
listview > row:selected:hover,
gridview > child:selected:hover,
flowbox > flowboxchild:selected:hover {
  background-color: alpha(@accent_bg_color, 0.20);
}

/* Hover on an unselected row stays neutral: hover is a hint, not a choice. */
.navigation-sidebar > row:hover,
listview > row:hover,
gridview > child:hover {
  background-color: alpha(@window_fg_color, 0.05);
}
CSS
}

write_css "$HOME/.config/gtk-4.0/gtk.css"
write_css "$HOME/.config/gtk-3.0/gtk.css"

# GNOME 47+ named accent, so libadwaita apps that ignore gtk.css still land in
# the right family. Nearest named hue to the theme accent.
if [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]] && command -v gsettings >/dev/null; then
  r=$((16#${accent:1:2})); g=$((16#${accent:3:2})); b=$((16#${accent:5:2}))
  named=$(awk -v r="$r" -v g="$g" -v b="$b" '
    BEGIN {
      max = r; if (g > max) max = g; if (b > max) max = b
      min = r; if (g < min) min = g; if (b < min) min = b
      d = max - min
      if (d == 0) { print "slate"; exit }
      if (max == r)      h = 60 * (((g - b) / d) % 6)
      else if (max == g) h = 60 * (((b - r) / d) + 2)
      else               h = 60 * (((r - g) / d) + 4)
      if (h < 0) h += 360
      if (max > 0 && d / max < 0.18) { print "slate"; exit }
      if (h < 15  || h >= 345) print "red"
      else if (h < 45)  print "orange"
      else if (h < 70)  print "yellow"
      else if (h < 160) print "green"
      else if (h < 200) print "teal"
      else if (h < 260) print "blue"
      else if (h < 300) print "purple"
      else print "pink"
    }')
  gsettings set org.gnome.desktop.interface accent-color "$named" 2>/dev/null || true
fi

exit 0
